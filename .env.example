# Gemini API (Google AI Studio에서 발급)
GOOGLE_API_KEY=your_google_api_key_here

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=youth-policy-index

# 온통청년 OpenAPI (공공데이터포털에서 신청)
YOUTH_POLICY_API_KEY=your_youth_policy_api_key_here

# 선택: Gemini 모델명 (기본값 gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
